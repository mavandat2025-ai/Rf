-- Khai b=C3=A1o bi=E1=BA=BFn cho Submerged Island
local SubNPC =3D Vector3.new(-16267.8, 25.4, 1373.2)
local TeleportedToSub =3D false

local function IsInSubmergedIsland()
    if not plr or not plr:FindFirstChild("Data") then return false end
    local data =3D plr.Data
    local currentIsland =3D data:FindFirstChild("SpawnPoint") or data:FindF=
irstChild("CurrentIsland")
    if not currentIsland then return false end
    local name =3D tostring(currentIsland.Value):lower()
    return string.find(name, "submerged") or string.find(name, "underwater"=
)
end

-- Theo d=C3=B5i khi nh=C3=A2n v=E1=BA=ADt respawn
plr.CharacterAdded:Connect(function(char)
    Root =3D char:WaitForChild("HumanoidRootPart", 10)
    task.defer(function()
        task.wait(2)
        if Root then
            TeleportedToSub =3D IsInSubmergedIsland()
        end
    end)
end)

-- Function cho Level Farming
spawn(function()
    while wait(Sec) do
        pcall(function()
            if _G.StartFarm and _G.MethodSelect =3D=3D "Level Farming" then
                -- X=E1=BB=AD l=C3=BD Submerged Island cho level &gt;=3D 26=
00
                local lvl =3D plr.Data.Level.Value
                if lvl &gt;=3D 2600 and not TeleportedToSub then
                    if not IsInSubmergedIsland() then
                        TeleportedToSub =3D true
                        repeat=20
                            task.wait()=20
                            _tp(CFrame.new(SubNPC))
                        until not _G.StartFarm or (Root.Position - SubNPC).=
Magnitude &lt;=3D 80
                       =20
                        -- G=E1=BB=8Di NPC =C4=91=E1=BB=83 =C4=91=E1=BA=BFn=
