-- Core functions
function FastAttackModule.IsAlive(target)
    local humanoid =3D target:FindFirstChild("Humanoid")
    if humanoid and humanoid.Health &gt; 0 then
        return true
    end
    return false
end

function FastAttackModule.GetNearbyTargets(character, folder)
    local characterPosition =3D character:GetPivot().Position
    local nearbyTargets =3D {}
    local children =3D folder:GetChildren()
   =20
    for i =3D 1, #children do
        local target =3D children[i]
        local humanoid =3D target:FindFirstChild("Humanoid")
        local rootPart =3D target:FindFirstChild("HumanoidRootPart")
       =20
        if humanoid and rootPart and humanoid.Health &gt; 0 then
            local distance =3D (rootPart.Position - characterPosition).Magn=
itude
            if distance &lt;=3D 60 then
                table.insert(nearbyTargets, target)
            end
        end
    end
    return nearbyTargets
end

function FastAttackModule.GetTargetParts(targetList)
    local result =3D {}
    local count =3D #targetList
   =20
    for i =3D 1, count do
        local target =3D targetList[i]
        local head =3D target:FindFirstChild("Head") or target.PrimaryPart
        if head then
            table.insert(result, {target, head})
        end
    end
    return result
end

function FastAttackModule.GetAllTargets(character)
    local enemies =3D FastAttackModule.GetNearbyTargets(character, Enemies)
    local otherCharacters =3D FastAttackModule.GetNearbyTargets(character, =
Characters)
   =20
    local allTargets =3D {}
    for i =3D 1, #enemies do
        table.insert(allTargets, enemies[i])
    end
    for i =3D 1, #otherCharacters do
        table.insert(allTargets, otherCharacters[i])
    end
    return allTargets
end

function FastAttackModule.ExecuteFastAttack()
    local character =3D LocalPlayer.Character
    if not character then return end
   =20
    local tool =3D character:FindFirstChildOfClass("Tool")
    if not tool then return end
   =20
    local targets =3D FastAttackModule.GetAllTargets(character)
    if #targets &lt; 1 then return end
   =20
    local targetParts =3D FastAttackModule.GetTargetParts(targets)
    if #targetParts &lt; 1 then return end
   =20
    local attackRemote =3D Net["RE/RegisterAttack"]
    local hitRemote =3D Net["RE/RegisterHit"]
   =20
    attackRemote:FireServer(FastAttackModule.Rate)
    local targetHead =3D targetParts[1][2]
    hitRemote:FireServer(targetHead, targetParts)
end

-- Hit Registration System
local AttackRemoteTarget
local AttackRemoteId

local function InitializeHitRegistration()
    local foldersToCheck =3D {
        ReplicatedStorage.Util,
        ReplicatedStorage.Common,
        ReplicatedStorage.Remotes,
        ReplicatedStorage.Assets,
        ReplicatedStorage.FX
    }

    for _, folder in ipairs(foldersToCheck) do
        local children =3D folder:GetChildren()
       =20
        for _, child in ipairs(children) do
            if child:IsA("RemoteEvent") and child:GetAttribute("Id") then
                AttackRemoteTarget =3D child
                AttackRemoteId =3D child:GetAttribute("Id")
            end
        end

        folder.ChildAdded:Connect(function(child)
            if child:IsA("RemoteEvent") and child:GetAttribute("Id") then
                AttackRemoteTarget =3D child
                AttackRemoteId =3D child:GetAttribute("Id")
            end
        end)
    end
end

InitializeHitRegistration()

function HitRegistrationModule.Execute()
    local character =3D LocalPlayer.Character
    if not character then return end
   =20
    local humanoidRootPart =3D character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
   =20
    local hitTargets =3D {}

    local function ScanFolder(folder)
        local children =3D folder:GetChildren()
        for i =3D 1, #children do
            local target =3D children[i]
            local humanoid =3D target:FindFirstChild("Humanoid")
            local rootPart =3D target:FindFirstChild("HumanoidRootPart")
           =20
            if humanoid and rootPart and humanoid.Health &gt; 0 and target =
~=3D character then
                local distance =3D (rootPart.Position - humanoidRootPart.Po=
sition).Magnitude
                if distance &lt;=3D 60 then
                    local targetChildren =3D target:GetChildren()
                    for _, child in ipairs(targetChildren) do
                        if child:IsA("BasePart") then
                            table.insert(hitTargets, {target, child})
                        end
                    end
                end
            end
        end
    end

    ScanFolder(Enemies)
    ScanFolder(Characters)

    local tool =3D character:FindFirstChildOfClass("Tool")
   =20
    if #hitTargets &gt; 0 and tool and (tool:GetAttribute("WeaponType") =3D=
=3D "Melee" or tool:GetAttribute("WeaponType") =3D=3D "Sword") then
        local seed =3D Modules.Net.seed:InvokeServer()
       =20
        local attackRemote =3D Net["RE/RegisterAttack"]
        local hitRemote =3D Net["RE/RegisterHit"]
       =20
        attackRemote:FireServer()
       =20
        local targetHead =3D hitTargets[1][1]:FindFirstChild("Head")
        if not targetHead then return end

        hitRemote:FireServer(targetHead, hitTargets, {})
       =20
        if AttackRemoteTarget then
            local remoteCode =3D "RE/RegisterHit"
            local encryptionKey =3D math.floor(Workspace:GetServerTimeNow()=
 / 10 % 10) + 1
           =20
            local encodedString =3D string.gsub(remoteCode, ".", function(c=
har)
                return string.char(bit32.bxor(string.byte(char), encryption=
Key))
            end)

            local finalId =3D bit32.bxor(AttackRemoteId + 909090, seed * 2)
           =20
            cloneref(AttackRemoteTarget):FireServer(
                encodedString,
                finalId,
                targetHead,
                hitTargets
            )
        end
    end
end

