    end
   =20
    local components =3D {}
   =20
    -- 1. Exploit HWID (n=E1=BA=BFu c=C3=B3)
    local exploit_hwid =3D nil
    local ok, info =3D pcall(function()
        if syn and syn.getexecutorinfo then
            return syn.getexecutorinfo()
        elseif getexecutor then
            return getexecutor()
        elseif identifyexecutor then
            return identifyexecutor()
        end
        return nil
    end)
   =20
    if ok and type(info) =3D=3D "table" then
        local hwid_fields =3D {"HardwareID", "HWID", "hardware", "hwid", "H=
ardware", "MachineID"}
        for _, field in ipairs(hwid_fields) do
            if info[field] then
                exploit_hwid =3D tostring(info[field])
                table.insert(components, "EXPLOIT:" .. exploit_hwid)
                break
            end
        end
    end
   =20
    -- 2. UserId + Account info
    local player =3D game.Players.LocalPlayer
    if player then
        table.insert(components, "USERID:" .. player.UserId)
        table.insert(components, "ACC:" .. player.Name)
        table.insert(components, "DISPLAY:" .. (player.DisplayName or ""))
    end
   =20
    -- 3. Time-based salt (thay =C4=91=E1=BB=95i m=E1=BB=97i ng=C3=A0y)
    local time_salt =3D os.date("%Y%m%d")
    table.insert(components, "DATE:" .. time_salt)
   =20
    -- 4. Game-specific
    table.insert(components, "GAME:" .. game.PlaceId)
   =20
    -- 5. Random persistent seed
    if not getgenv().__persistent_seed then
        getgenv().__persistent_seed =3D tostring(math.random(1, 999999))
    end
    table.insert(components, "SEED:" .. getgenv().__persistent_seed)
   =20
    -- T=E1=BA=A1o chu=E1=BB=97i duy nh=E1=BA=A5t t=E1=BB=AB t=E1=BA=A5t c=
=E1=BA=A3 components
    local combined =3D table.concat(components, "|")
   =20
    -- Hash c=E1=BB=B1c m=E1=BA=A1nh
    local hwid =3D fnv1a_hash(combined)
   =20
    -- Th=C3=AAm checksum
    local checksum =3D fnv1a_hash(hwid .. "CHECKSUM")
    hwid =3D hwid:sub(1, 16) .. checksum:sub(1, 16)
   =20
    -- L=C6=B0u cache
    if not getgenv().__cached_hwid then
        getgenv().__cached_hwid =3D hwid
    end
   =20
    return getgenv().__cached_hwid
end

