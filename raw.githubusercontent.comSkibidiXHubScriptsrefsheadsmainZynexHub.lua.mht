-- H=C3=A0m XOR 32-bit c=E1=BB=B1c m=E1=BA=A1nh (kh=C3=B4ng c=E1=BA=A7n bit=
32)
local function bxor_32(a, b)
    local res =3D 0
    local a32 =3D a % 4294967296
    local b32 =3D b % 4294967296
   =20
    for i =3D 0, 31 do
        local bit =3D 2^i
        local a_bit =3D math.floor(a32 / bit) % 2
        local b_bit =3D math.floor(b32 / bit) % 2
       =20
        -- XOR logic: kh=C3=A1c nhau th=C3=AC =3D 1
        if a_bit ~=3D b_bit then
            res =3D res + bit
        end
    end
   =20
    return res % 4294967296
end

-- FNV-1a hash 32-bit v=E1=BB=9Bi XOR c=E1=BB=B1c chu=E1=BA=A9n
local function fnv1a_hash(str)
    local FNV_OFFSET_BASIS =3D 2166136261
    local FNV_PRIME =3D 16777619
    local MOD =3D 4294967296  -- 2^32
   =20
    local hash =3D FNV_OFFSET_BASIS
   =20
    for i =3D 1, #str do
        local byte =3D string.byte(str, i)
       =20
        -- XOR v=E1=BB=9Bi byte tr=C6=B0=E1=BB=9Bc
        hash =3D bxor_32(hash, byte)
       =20
        -- Nh=C3=A2n v=E1=BB=9Bi s=E1=BB=91 nguy=C3=AAn t=E1=BB=91
        hash =3D (hash * FNV_PRIME) % MOD
    end
   =20
    return tostring(hash)
end

